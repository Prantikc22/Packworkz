<section class="pw-commerce-band" aria-labelledby="pw-commerce-title">
  <div class="pw-commerce-band__inner">
    <div class="pw-commerce-band__copy">
      <p class="pw-kicker">TWO BUYING PATHS. ONE PACKAGING SYSTEM.</p>
      <h2 id="pw-commerce-title">Start small. Scale without starting over.</h2>
      <p>
        Standard formats move through secure self-serve checkout. Rollstock, complex inserts and enterprise
        volumes move to a managed production plan with a named owner and reviewed estimate.
      </p>
      <div class="pw-commerce-band__links">
        <a href="{{ routes.all_products_collection_url }}">Browse instant-buy products <span aria-hidden="true">&#8594;</span></a>
        <a href="https://packworkz.com/configure">Request managed pricing <span aria-hidden="true">&#8594;</span></a>
      </div>
    </div>

    <div class="pw-commerce-visual" aria-label="SmartStock reorder preview">
      <div class="pw-commerce-visual__head">
        <div>
          <small>SMARTSTOCK AI</small>
          <strong>Reorder signal</strong>
        </div>
        <span class="pw-live"><i></i> ACTIVE</span>
      </div>
      <div class="pw-commerce-visual__sku">
        <span>250g stand-up pouch</span>
        <strong>28 <small>days before stockout</small></strong>
      </div>
      <div class="pw-stockline" aria-hidden="true">
        <span class="pw-stockline__fill"></span>
        <i class="pw-stockline__signal"></i>
      </div>
      <div class="pw-commerce-visual__labels">
        <span>Today</span><strong>Reorder prepared</strong><span>Projected stockout</span>
      </div>
      <div class="pw-commerce-visual__stats">
        <div><small>RECOMMENDED</small><strong>18,000 units</strong></div>
        <div><small>COST AVOIDED</small><strong>₹1.8L</strong></div>
        <div><small>SUPPLY COVERAGE</small><strong>3 vendors</strong></div>
      </div>
      <a class="pw-commerce-visual__cta" href="https://packworkz.com/smartstock">See how SmartStock works <span aria-hidden="true">&#8594;</span></a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Packworkz SmartStock",
  "settings": [],
  "presets": [{ "name": "Packworkz SmartStock" }]
}
{% endschema %}
