{
  "version": 2,
  "buildCommand": "pnpm install && PORT=5000 BASE_PATH=/ pnpm --filter @workspace/packwerk run build && pnpm --filter @workspace/api-server run build",
  "outputDirectory": "artifacts/packwerk/dist/public",
  "functions": {
    "api/server.mjs": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/server"
    },
    {
      "src": "^/(.+)/$",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "/sustainable-catalog",
      "status": 308,
      "headers": {
        "Location": "/sustainable"
      }
    },
    {
      "src": "/sustainability",
      "status": 308,
      "headers": {
        "Location": "/sustainable"
      }
    },
    {
      "src": "/quote",
      "status": 308,
      "headers": {
        "Location": "/configure"
      }
    },
    {
      "src": "/(?:login|signup|change-password|track-order)",
      "dest": "/index.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "src": "/cart(?:/.*)?",
      "dest": "/index.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "src": "/configure/(?:step|confirmed)(?:/.*)?",
      "dest": "/index.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "src": "/quote/(?:step|confirmed)(?:/.*)?",
      "dest": "/index.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "src": "/(?:admin|dashboard)(?:/.*)?",
      "dest": "/index.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "src": "/lp/(.*)",
      "dest": "/index.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(?:pack-ai|smartstock/demo)",
      "dest": "/index.html"
    },
    {
      "src": "/manufacturers/[^/]+",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
